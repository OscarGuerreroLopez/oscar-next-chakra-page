{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "permission": {
    "*": "allow",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "npm test*": "allow",
      "pnpm test*": "allow",
      "rm -rf*": "deny",
      "git reset --hard*": "ask",
      "git push --force*": "deny"
    },
    "edit": "ask",
    "read": {
      "*": "allow",
      "**/.env*": "deny"
    },
    "external_directory": "ask",
    "webfetch": "allow",
    "websearch": "allow"
  }
}
